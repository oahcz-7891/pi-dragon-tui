{
	"name": "pi-dragon-tui",
	"version": "0.2.2",
	"description": "Dragon Ball / Namek-flavored pi extension: rounded or flat editor frame, framed modals, Namekian working spinner, a tok/s stat, and markdown output tinted to match.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oahcz-7891/pi-dragon-tui.git"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"theme",
		"tui"
	],
	"files": [
		"index.ts",
		"palette.ts",
		"picker.ts",
		"rounded-frame.ts",
		"tint.ts",
		"assets"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		],
		"image": "https://raw.githubusercontent.com/oahcz-7891/pi-dragon-tui/main/assets/overview.png"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org"
	}
}
